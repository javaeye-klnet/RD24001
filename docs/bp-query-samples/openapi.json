{
  "openapi": "3.0.3",
  "info": {
    "title": "RD24001 BP sample GET endpoints",
    "version": "3.0.0",
    "description": "Static public synthetic data. shipImoNumber and voyageNumber correspond semantically to IMO0140 and IMO0191. All other fields remain project data; see imo-mapping.json. The former imoShipNumber field is renamed to shipImoNumber. Fixed paths, not dynamic search or official IMO reporting."
  },
  "servers": [
    {
      "url": "https://raw.githubusercontent.com/javaeye-klnet/RD24001/main/docs/bp-query-samples",
      "description": "Public static JSON sample paths; no dynamic filtering."
    }
  ],
  "components": {
    "schemas": {
      "BpSample": {
        "type": "object",
        "required": ["sample", "shipImoNumber", "voyageNumber", "arrivalYear", "arrivalSequence", "bpId", "payload"],
        "properties": {
          "sample": {"type": "boolean"},
          "shipImoNumber": {"type": "string", "maxLength": 7, "description": "Project JSON name reflecting IMO0140 data element Ship IMO number; Reference Model FAL_ Transport Means. IMO Ship Number. Identifier.", "example": "1234567"},
          "voyageNumber": {"type": "string", "maxLength": 17, "description": "Project JSON name; semantic mapping to IMO0191 Voyage number.", "example": "001W"},
          "arrivalYear": {"type": "string", "description": "RD24001 simulated port context; not an asserted IMO mapping."},
          "arrivalSequence": {"type": "string", "description": "RD24001 simulated port arrival count; not the voyage number."},
          "bpId": {"type": "string", "description": "RD24001 business process ID."},
          "payload": {"type": "object", "description": "Original BP-specific project fields; no blanket IMO mapping is asserted."}
        }
      }
    }
  },
  "paths": {
    "/ships/1234567/arrivals/2026/001/bp-01.json": {
      "get": {
        "summary": "BP-01 synthetic sample",
        "operationId": "getBp01Sample",
        "responses": {
          "200": {
            "description": "Static synthetic BP sample",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BpSample"
                }
              }
            }
          }
        }
      }
